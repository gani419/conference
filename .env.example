# Shared public connection configuration
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
LIVEKIT_URL=

# Backend-only values. Never export these into web/mobile builds.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WEB_ORIGIN=http://localhost:5173
BACKEND_WORKER_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
LIVEKIT_DOMAIN=
LIVEKIT_NODE_IP=

# Shared Firebase project ID (public; also the Hosting deployment target)
FIREBASE_PROJECT_ID=

# Firebase public app configuration (safe to bundle through the allowlist)
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_VAPID_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_API_KEY=
# Backend-only one-line service account JSON. Never bundle or commit.
FCM_SERVICE_ACCOUNT_JSON=

# Private Gmail SMTP (never included in mobile/web builds)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Conference

# Optional Hosting site IDs; primary defaults to the Firebase project ID
FIREBASE_HOSTING_SITE_ID=
FIREBASE_HOSTING_LEGACY_SITE_ID=
# Comma-separated additional browser origins permitted by the backend
WEB_ADDITIONAL_ORIGINS=
