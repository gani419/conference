{
  "name": "conference-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "predev": "npm run configure",
    "dev": "vite --host localhost --port 5173 --strictPort",
    "prebuild": "npm run configure",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host localhost --port 5173 --strictPort",
    "test": "playwright test",
    "postbuild": "node scripts/verify-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "firebase": "12.19.0",
    "livekit-client": "2.22.3",
    "lucide-react": "1.53.0",
    "papaparse": "5.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
